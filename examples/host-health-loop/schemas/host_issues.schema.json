{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["generated_at", "total_issues", "issues"],
  "properties": {
    "generated_at": { "type": "string" },
    "total_issues": { "type": "integer" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "ip", "severity", "category", "detail", "suggested_action"],
        "properties": {
          "host": { "type": "string" },
          "ip": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "warning"] },
          "category": { "type": "string", "enum": ["disk", "memory", "load", "service_down"] },
          "metric": { "type": "string" },
          "value": { "type": "string" },
          "detail": { "type": "string" },
          "suggested_action": { "type": "string" }
        }
      }
    }
  }
}
